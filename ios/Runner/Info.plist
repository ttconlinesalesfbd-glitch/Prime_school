<?xml version="1.0" encoding="UTF-8"?> 
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- ================= APP METADATA ================= -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>

    <key>CFBundleDisplayName</key>
    <string>Prime Education Public School</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>Prime Education</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>

    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- ================= LAUNCH SCREEN ================= -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!-- ================= ORIENTATION ================= -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- ================= SYSTEM ================= -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>

    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- ================= FIREBASE ================= -->
    <key>FirebaseAppDelegateProxyEnabled</key>
    <false/>

    <!-- ================= PUSH NOTIFICATIONS ================= -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>

    <key>NSUserNotificationUsageDescription</key>
    <string>
        This app uses notifications to send important school announcements,
        homework alerts, and academic updates.
    </string>

    <!-- ================= NETWORK / API (✅ FIXED ATS) ================= -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSExceptionDomains</key>
        <dict>
            <key>school.edusathi.in</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>

    <!-- Required for url_launcher -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>http</string>
        <string>https</string>
    </array>

    <!-- ================= LOCATION (🔥 GEO ATTENDANCE) ================= -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>
        This app uses your location to allow teachers to mark attendance within school premises.
    </string>

    <!-- ================= KEYCHAIN ================= -->
    <key>KeychainSharing</key>
    <array>
        <string>$(AppIdentifierPrefix)com.peps.apppro</string>
    </array>

    <!-- ================= PHOTO / FILE ACCESS ================= -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>
        This app requires access to your photo library to upload homework files and view study materials.
    </string>

    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>
        This app needs permission to save downloaded homework files to your device.
    </string>

</dict>
</plist>